# Runtime mode. Next.js sets this automatically for dev/build/start.
NODE_ENV=development

# Algolia docs search. Use a search-only API key here because NEXT_PUBLIC_ values
# are bundled into the browser.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=

# npm publish credentials. In GitHub Actions this is stored as NPM_TOKEN and
# passed to npm as NODE_AUTH_TOKEN.
NPM_TOKEN=
NODE_AUTH_TOKEN=

# Vercel deployment credentials used by the docs deploy workflow.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
