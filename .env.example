# Runtime mode. Next.js sets this automatically for dev/build/start.
NODE_ENV=development

# Public docs URL used for canonical links, sitemap URLs, and social previews.
NEXT_PUBLIC_SITE_URL=https://rn-kit.vercel.app

# Optional Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Algolia docs search. Use a search-only API key here because NEXT_PUBLIC_ values
# are bundled into the browser.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=

# npm publish credentials. In GitHub Actions this is stored as NPM_TOKEN and
# passed to npm as NODE_AUTH_TOKEN.
NPM_TOKEN=
NODE_AUTH_TOKEN=

# Vercel deployment token used by the docs deploy workflow.
# Store this as the VERCEL_TOKEN GitHub Actions secret.
VERCEL_TOKEN=
