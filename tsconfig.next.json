{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app/**/*",
    "docs/**/*",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "lib",
    "node_modules",
    ".storybook",
    "stories"
  ]
}
