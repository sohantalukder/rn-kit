{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["es2021", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2021",
    "types": ["node", "react", "react-native", "jest"]
  },
  "include": ["src/**/*", "__tests__/**/*"],
  "exclude": ["lib", "node_modules"]
}
