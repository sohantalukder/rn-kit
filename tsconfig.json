{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": [
      "es2021",
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@sohantalukder/rn-kit": [
        "src"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "es2021",
    "types": [
      "node",
      "react",
      "react-native",
      "jest"
    ],
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "app/**/*",
    "docs/**/*",
    "next-env.d.ts",
    "next.config.ts"
  ],
  "exclude": [
    "lib",
    "node_modules"
  ]
}
