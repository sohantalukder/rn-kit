{
  "name": "@sohantalukder/rn-kit",
  "version": "0.1.0",
  "description": "Reusable React Native UI components extracted from Sohan Talukder's boilerplate.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "bob clean",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "theme",
    "design-system",
    "typescript"
  ],
  "author": "Sohan Talukder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohantalukder/rn-kit.git"
  },
  "bugs": {
    "url": "https://github.com/sohantalukder/rn-kit/issues"
  },
  "homepage": "https://github.com/sohantalukder/rn-kit#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@d11/react-native-fast-image": ">=8.0.0",
    "@gorhom/bottom-sheet": ">=5.0.0",
    "@react-navigation/native": ">=7.0.0",
    "@react-navigation/stack": ">=7.0.0",
    "@shopify/flash-list": ">=1.7.0",
    "react": ">=18.2.0",
    "react-error-boundary": ">=5.0.0",
    "react-native": ">=0.74.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=15.0.0",
    "react-native-webview": ">=13.0.0"
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@d11/react-native-fast-image": "^8.6.3",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/stack": "^7.4.2",
    "@react-native/babel-preset": "^0.80.1",
    "@react-native/typescript-config": "^0.80.1",
    "@shopify/flash-list": "^1.8.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-native-builder-bob": "^0.40.13",
    "react-native-webview": "^13.15.0",
    "typescript": "^5.7.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
