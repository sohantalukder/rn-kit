{
  "name": "@sohantalukder/rn-kit",
  "version": "0.1.0",
  "description": "Reusable React Native UI components extracted from Sohan Talukder's boilerplate.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "assets/readme/rn-kit-hero.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "bob clean",
    "docs:build": "next build --webpack",
    "docs:dev": "next dev --webpack",
    "docs:start": "next start",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "test": "jest",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "typecheck:storybook": "tsc --noEmit --project stories/tsconfig.json",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "theme",
    "design-system",
    "typescript"
  ],
  "author": "Sohan Talukder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohantalukder/rn-kit.git"
  },
  "bugs": {
    "url": "https://github.com/sohantalukder/rn-kit/issues"
  },
  "homepage": "https://github.com/sohantalukder/rn-kit#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=15.0.0"
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@react-native/babel-preset": "^0.80.1",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/typescript-config": "^0.80.1",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/addon-themes": "^10.4.4",
    "@storybook/nextjs": "^10.4.4",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "lucide-react": "^1.18.0",
    "next": "^16.2.9",
    "react-dom": "^19.2.7",
    "react-native-builder-bob": "^0.40.13",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "^19.2.7",
    "storybook": "^10.4.4",
    "typescript": "^5.7.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
